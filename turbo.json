{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": { "dependsOn": ["check:type", "^build"], "outputs": ["dist/**"] },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "test:coverage": { "outputs": ["coverage/**", "junit.xml"] },
    "lint": { "outputs": [] },
    "check:type": { "dependsOn": ["^build"], "outputs": [] }
  }
}
