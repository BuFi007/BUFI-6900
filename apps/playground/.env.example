# BUFI-6900 playground — every value has a sandbox default, so an empty .env works.
# Modular Wallets API: the local mock (bun run mock:circle at the repo root). Base URL only, no chain suffix.
VITE_CLIENT_URL=http://127.0.0.1:8788/v1/rpc/w3s/buidl
# The mock accepts any non-empty client key.
VITE_CLIENT_KEY=sandbox-client-key
# anvil, used for direct reads and the dev-only "Fund me" / relayer buttons (anvil's well-known keys).
VITE_ANVIL_RPC_URL=http://127.0.0.1:8545
