{
  "name": "@bufi/mock-circle",
  "version": "0.1.0",
  "private": true,
  "description": "Local stand-in for Circle's Modular Wallets API (JSON-RPC: circle_*, pm_*, rp_*, ERC-4337 bundler) plus the deployer that recreates Circle's ERC-6900 v0.7 stack at Circle's canonical addresses on anvil.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./deploy": "./src/deploy.ts",
    "./server": "./src/server.ts",
    "./anvil": "./src/anvil.ts"
  },
  "scripts": {
    "dev": "bun run src/cli/dev.ts",
    "deploy": "bun run src/deploy.ts",
    "serve": "bun run src/server.ts",
    "test": "bun test --timeout 240000",
    "check:type": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "viem": "2.45.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.10",
    "typescript": "5.8.2"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
