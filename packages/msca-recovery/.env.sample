# Common
BROADCAST_OPERATION=true ## true/false
MSCA_WALLET_ADDRESS='0x...'
BLOCKCHAIN='POLYGON-AMOY' ## POLYGON-AMOY/POLYGON/ETH/ETH-SEPOLIA/ARB/ARB-SEPOLIA + BUFI: LOCAL-SANDBOX/AVAX-FUJI/ARC-TESTNET
BUNDLER_RPC_URL='https://polygon-amoy.g.alchemy.com/v2/<api-key>' ## Set with your blockchain provider (i.e. Infura, Alchemy, etc.); LOCAL-SANDBOX: http://127.0.0.1:8788/v1/rpc/w3s/buidl
BUNDLER_BEARER_TOKEN='' ## BUFI: sent as `Authorization: Bearer <token>` on every bundler/RPC call. Required by the @bufi/mock-circle sandbox (any non-empty value); leave empty for URL-keyed providers
SIGNER_ADDRESSES='
[
  {
    "address": "0x..."
  },
  {
    "address": "0x..."
  },
  {
    "address": "0x...",
    "privateKey": "0x..."
  }
]
'
LOG_LEVEL='info'

# WalletConnect
# You can find both of the following in your WallectConnect project settings
# We recommend create a new project
WC_PROJECT_ID='<project-id>' ## WalletConnect project ID

# Token transfer
RECIPIENT_ADDRESS='0x...'
TRANSFER_AMOUNT=0.001
TOKEN='usdc' ## usdc only for now
TOKEN_ADDRESS='' ## BUFI (session-key-transfer / session-keys only): ERC-20 override; defaults to the chain's USDC. LOCAL-SANDBOX: contracts/deployments/local.json `tokens.usdc`
GAS_FEES_MULTIPLIER=1.2

# Session key (BUFI)
SESSION_KEY_PRIVATE_KEY='0x...' ## the agent key registered on the MSCA through BufiSessionKeyPlugin (never a wallet owner)
SESSION_KEY_PLUGIN_ADDRESS='' ## session-keys only: BufiSessionKeyPlugin; defaults per chain (LOCAL-SANDBOX: contracts/deployments/local.json `plugins.bufiSessionKey.address`)

# Signing
SIGNER_ADDRESS='0x...' ## Assumes address exists in SIGNER_ADDRESSES to get private key
USER_OP_HASH='0x...'
