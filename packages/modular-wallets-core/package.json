{
  "name": "@bufi/modular-wallets-core",
  "description": "BUFI fork of the Circle Modular Wallets web SDK with first-class ERC-6900 plugin and cascade-wallet support",
  "version": "1.0.15-bufi.0",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "license": "Apache-2.0",
  "homepage": "https://github.com/BuFi007/BUFI-6900",
  "repository": "BuFi007/BUFI-6900",
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "check:type": "tsc --project tsconfig.json --pretty --noEmit",
    "lint": "eslint . --fix",
    "lint:report": "rm -f eslint_report.json && eslint . --format json --no-warn-ignored > eslint_report.json || { eslint . --format stylish --no-warn-ignored; exit 1; }",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "uuid": "^11.0.3",
    "viem": "2.45.3",
    "web3": "4.16.0",
    "webauthn-p256": "0.0.5"
  },
  "devDependencies": {
    "@templates/eslint-config": "workspace:*",
    "@templates/jest": "workspace:*",
    "@templates/tsconfig": "workspace:*",
    "abitype": "1.2.4",
    "eslint": "10.5.0",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-fetch-mock": "3.0.3",
    "tsup": "8.4.0",
    "web3-errors": "1.3.1",
    "web3-types": "1.10.0"
  },
  "keywords": [
    "circle",
    "circle.com",
    "usdc",
    "euroc",
    "stablecoins",
    "modular wallets",
    "bufi",
    "erc-6900",
    "session keys",
    "address book",
    "cascade wallets"
  ]
}
