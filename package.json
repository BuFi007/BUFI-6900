{
  "name": "bufi-6900",
  "private": true,
  "description": "BUFI-6900 \u2014 ERC-6900 plugin sandbox for Circle Modular Smart Contract Accounts: redeployable Circle stack, BUFI plugins, forked SDK, mock Circle API and playground.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tooling/*"
  ],
  "scripts": {
    "anvil": "anvil --chain-id 31337 --code-size-limit 250000 --balance 1000000 --host 127.0.0.1 --port 8545",
    "build": "turbo run build",
    "check:type": "turbo run check:type",
    "contracts:build": "cd contracts && forge build",
    "contracts:coverage": "cd contracts && FOUNDRY_PROFILE=coverage forge coverage --ir-minimum --report summary",
    "contracts:fmt": "cd contracts && forge fmt",
    "contracts:lint": "cd contracts && solhint --config .solhint-src.json 'src/**/*.sol'",
    "contracts:lint:test": "cd contracts && solhint --config .solhint-test.json 'test/**/*.sol'",
    "contracts:slither": "cd contracts && slither . --filter-paths 'lib/|test/|script/' --exclude-dependencies --checklist",
    "contracts:snapshot": "cd contracts && forge snapshot --no-match-contract GhostShieldAddressBookTest",
    "contracts:test": "cd contracts && forge test -vv",
    "lint": "turbo run lint",
    "mock:circle": "bun run --cwd packages/mock-circle dev",
    "sandbox:e2e": "bun run --cwd apps/playground e2e",
    "stack:deploy": "cd contracts && forge script script/DeployStack.s.sol --rpc-url http://127.0.0.1:8545 --broadcast --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 -vv",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "2.9.16",
    "typescript": "5.8.2"
  },
  "engines": {
    "node": ">=24.18.0",
    "bun": ">=1.3.0"
  },
  "packageManager": "bun@1.3.10"
}
